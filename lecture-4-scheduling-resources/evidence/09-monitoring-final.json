    {
      "state": "inactive",
      "name": "ShopOrderSLOBreach",
      "query": "(histogram_quantile(0.95, sum by (le) (rate(shop_http_request_duration_seconds_bucket{method=\"POST\",namespace=\"shop\",path=\"/order\",service=\"shop-api\"}[2m]))) > 0.3 or (sum(rate(shop_http_requests_total{code!=\"201\",method=\"POST\",namespace=\"shop\",path=\"/order\",service=\"shop-api\"}[2m])) / sum(rate(shop_http_requests_total{method=\"POST\",namespace=\"shop\",path=\"/order\",service=\"shop-api\"}[2m]))) > 0.01) and on () (sum(increase(shop_http_requests_total{method=\"POST\",namespace=\"shop\",path=\"/order\",service=\"shop-api\"}[2m])) >= 20)",
      "duration": 30,
      "keepFiringFor": 0,
      "labels": {
        "namespace": "shop",
        "severity": "critical"
      },
      "annotations": {
        "description": "p95 выше 300 мс или более 1% ответов не 201; проверить CPU throttling API и PostgreSQL.",
        "summary": "SLA оформления заказа нарушен"
      },
      "alerts": [],
      "health": "ok",
      "evaluationTime": 0.000563614,
      "lastEvaluation": "2026-10-30T21:50:08.86425299Z",
      "type": "alerting"
    },
    {
